{
  "name": "@gentbajko/slopify",
  "version": "0.2.0",
  "description": "Turn a prompt into a finished video, locally, with your own provider keys",
  "license": "MIT",
  "author": "Gent Bajko",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/GentBajko/slopify.git",
    "directory": "packages/app"
  },
  "type": "module",
  "engines": {
    "node": ">=26"
  },
  "bin": {
    "slopify": "dist/edge/cli.js"
  },
  "files": [
    "dist",
    "!dist/**/*.d.ts"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/copy-migrations.mjs && node scripts/copy-web.mjs",
    "build:types": "tsc -p tsconfig.build.json --declaration --emitDeclarationOnly",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fastify/busboy": "^3.2.2",
    "@hono/node-server": "^2.1.1",
    "@hono/zod-validator": "^0.9.1",
    "fflate": "^0.8.3",
    "ffmpeg-static": "^5.3.0",
    "hono": "^4.13.5",
    "remark": "^15.0.1",
    "remark-gfm": "^4.0.1",
    "strip-markdown": "^6.0.0",
    "ulid": "^3.0.2",
    "zod": "^4.5.4"
  }
}
