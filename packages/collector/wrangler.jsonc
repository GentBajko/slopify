{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "slopify-collector",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-01",
  "observability": { "enabled": true },
  // The hostname is not decoration: the shipped app posts to
  // https://collector.slopify.stream (slices/telemetry/collector-client.ts) and the
  // Worker answers CORS for https://slopify.stream only. Deploying without this route
  // gives a collector nothing talks to. The zone has to be on the Cloudflare account
  // first; see "Deploying to Cloudflare" in the repository README.
  "routes": [{ "pattern": "collector.slopify.stream", "custom_domain": true }],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "slopify-collector",
      // Local runs (`wrangler dev`, `wrangler d1 execute --local`) key their state off the
      // database name and never read this, so the placeholder is enough to develop and to
      // pass `wrangler deploy --dry-run`. A real id only exists once someone with a
      // Cloudflare account has run `wrangler d1 create slopify-collector`; that command
      // prints the id and this line is where it goes. Anything invented here would deploy
      // a collector bound to a database nobody owns.
      "database_id": "D1_DATABASE_ID_PLACEHOLDER"
    }
  ]
}
