{
  "$schema": "https://biomejs.dev/schemas/2.5.11/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": ["**", "!**/dist", "!**/coverage", "!docs"]
  },
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "assist": {
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended"
    }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "semicolons": "always",
      "trailingCommas": "all"
    }
  },
  "overrides": [
    {
      "includes": ["packages/app/src/kernel/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["**/slices", "**/slices/**", "**/edge", "**/edge/**"],
                    "message": "kernel is the bottom layer: it may not import slices or edge."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["packages/app/src/slices/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["**/edge", "**/edge/**"],
                    "message": "slices sit below edge: they may not import edge."
                  },
                  {
                    "group": ["**/adapters", "**/adapters/**", "**/kernel/ports/registry.js"],
                    "message": "a slice never holds a provider adapter or the registry that hands one out: it is handed the wrapped calls of kernel/runner/providers.ts, so every provider call goes through the attempt wrapper."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["packages/app/src/adapters/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": [
                      "**/slices",
                      "**/slices/**",
                      "**/edge",
                      "**/edge/**",
                      "**/kernel",
                      "**/kernel/**",
                      "!**/kernel/ports",
                      "!**/kernel/ports/**",
                      "!**/kernel/clock.js",
                      "!**/kernel/log.js"
                    ],
                    "message": "adapters may import only kernel/ports and kernel/{clock,log}."
                  }
                ]
              }
            }
          }
        }
      }
    }
  ]
}
